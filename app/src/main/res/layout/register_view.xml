<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vGeneroRegister"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:hint="Genero"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="452dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vEdadRegister"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:hint="Edad"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="511dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vDniRegister"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:hint="Dni"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="395dp" />

    <Button
        android:id="@+id/vVolverRegister"
        android:layout_width="383dp"
        android:layout_height="53dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#4E4E4E"
        android:paddingVertical="10dp"
        android:text="Cancelar"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:cornerRadius="@dimen/item_transform_image_length"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.285"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btIniciarSesion" />

    <Button
        android:id="@+id/vCrearUsuario"
        android:layout_width="387dp"
        android:layout_height="64dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="84dp"
        android:backgroundTint="@color/primary"
        android:paddingVertical="14dp"
        android:text="Iniciar Sesion"
        android:textStyle="bold"
        app:cornerRadius="@dimen/item_transform_image_length"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etClave" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vEmailRegister"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:hint="Email"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="342dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vTelefonoRegister"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:hint="Numero de Telefono"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="289dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vDireccionRegister"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:hint="Direccion"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="231dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vPasswordRegister"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:hint="Contraseña"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="173dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vNombreRegister"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:hint="Usuario"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="118dp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Registrarse"
        android:textColor="#000000"
        android:textStyle="bold|italic"
        tools:layout_editor_absoluteX="140dp"
        tools:layout_editor_absoluteY="42dp"
        tools:textSize="26sp" />
</androidx.constraintlayout.widget.ConstraintLayout>