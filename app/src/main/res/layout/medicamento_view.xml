<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/vToMedicamentoEdit"
        android:layout_width="370dp"
        android:layout_height="53dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="108dp"
        android:backgroundTint="#015A75"
        android:paddingVertical="14dp"
        android:text="Editar Medicamento"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.292"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vIntervaloMedicamento"
        android:layout_width="364dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="31dp"
        android:layout_marginBottom="20dp"
        android:clickable="false"
        android:hint="Intervalo"
        app:layout_constraintBottom_toTopOf="@+id/vDosis"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vCantidadMedicamento" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vDosis"
        android:layout_width="364dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="31dp"
        android:layout_marginBottom="95dp"
        android:clickable="false"
        android:hint="Dosis"
        app:layout_constraintBottom_toTopOf="@+id/vToMedicamentoEdit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vIntervaloMedicamento" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="155dp"
        android:layout_height="35dp"
        android:layout_marginStart="128dp"
        android:layout_marginTop="71dp"
        android:layout_marginEnd="128dp"
        android:layout_marginBottom="71dp"
        android:fontFamily="sans-serif"
        android:text="Medicamento"
        android:textColor="#000000"
        android:textStyle="bold|italic"
        app:layout_constraintBottom_toTopOf="@+id/vNombreMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:textSize="26sp" />

    <Button
        android:id="@+id/vVolverMedicamento"
        android:layout_width="370dp"
        android:layout_height="53dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="23dp"
        android:layout_marginEnd="29dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#4E4E4E"
        android:paddingVertical="10dp"
        android:text="Volver"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vToMedicamentoEdit" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vCantidadMedicamento"
        android:layout_width="364dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="31dp"
        android:layout_marginBottom="20dp"
        android:clickable="false"
        android:hint="Cantidad"
        app:layout_constraintBottom_toTopOf="@+id/vIntervaloMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vNombreMedicamento" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vNombreMedicamento"
        android:layout_width="364dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="31dp"
        android:layout_marginBottom="20dp"
        android:clickable="false"
        android:hint="Nombre"
        app:layout_constraintBottom_toTopOf="@+id/vCantidadMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView11" />

</androidx.constraintlayout.widget.ConstraintLayout>