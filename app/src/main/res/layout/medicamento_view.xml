<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/vToMedicamentoEdit"
        android:layout_width="370dp"
        android:layout_height="53dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="108dp"
        android:backgroundTint="#015A75"
        android:paddingVertical="14dp"
        android:text="Editar Medicamento"
        android:textStyle="bold"
        app:cornerRadius="@dimen/item_transform_image_length"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.292"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etClave" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vIntervaloMedicamento"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:clickable="false"
        android:hint="Intervalo"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="342dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vDosis"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:clickable="false"
        android:hint="Dosis"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="417dp" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Medicamento"
        android:textColor="#000000"
        android:textStyle="bold|italic"
        tools:layout_editor_absoluteX="128dp"
        tools:layout_editor_absoluteY="71dp"
        tools:textSize="26sp" />

    <Button
        android:id="@+id/vVolverMedicamento"
        android:layout_width="370dp"
        android:layout_height="53dp"
        android:layout_marginHorizontal="24dp"
        android:backgroundTint="#4E4E4E"
        android:paddingVertical="10dp"
        android:text="Volver"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:cornerRadius="@dimen/item_transform_image_length"
        tools:layout_editor_absoluteX="12dp"
        tools:layout_editor_absoluteY="646dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vCantidadMedicamento"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:clickable="false"
        android:hint="Cantidad"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="262dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/vNombreMedicamento"
        android:layout_width="364dp"
        android:layout_height="46dp"
        android:clickable="false"
        android:hint="Nombre"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="177dp" />
</androidx.constraintlayout.widget.ConstraintLayout>