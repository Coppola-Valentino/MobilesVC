<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textView58"
        android:layout_width="100dp"
        android:layout_height="22dp"
        android:text="Dosis:"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/vDosis"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.051"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView57"
        android:layout_width="200dp"
        android:layout_height="22dp"
        android:layout_marginTop="332dp"
        android:text="Intervalo entre Dosis:"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/vIntervaloMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.075"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/textView56"
        android:layout_width="200dp"
        android:layout_height="22dp"
        android:text="Cantidad de Dosis:"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/vCantidadMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.075"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView55"
        android:layout_width="200dp"
        android:layout_height="22dp"
        android:text="Nombre del Medicamento:"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/vNombreMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.077"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/vDosis"
        android:layout_width="364dp"
        android:layout_height="50dp"
        android:layout_marginBottom="96dp"
        android:text="Dosis"
        android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@+id/vToMedicamentoEdit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/vIntervaloMedicamento"
        android:layout_width="364dp"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:text="Intervalo"
        android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@+id/vDosis"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/vCantidadMedicamento"
        android:layout_width="364dp"
        android:layout_height="50dp"
        android:layout_marginBottom="23dp"
        android:text="Cantidad de Dosis"
        android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@+id/vIntervaloMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/vNombreMedicamento"
        android:layout_width="364dp"
        android:layout_height="50dp"
        android:layout_marginBottom="24dp"
        android:text="Nombre"
        android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@+id/vCantidadMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/vToMedicamentoEdit"
        android:layout_width="370dp"
        android:layout_height="53dp"
        android:layout_marginBottom="23dp"
        android:backgroundTint="#015A75"
        android:paddingVertical="14dp"
        android:text="Editar Medicamento"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/vVolverMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.292"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="170dp"
        android:layout_height="35dp"
        android:layout_marginStart="128dp"
        android:layout_marginTop="71dp"
        android:layout_marginEnd="128dp"
        android:layout_marginBottom="102dp"
        android:fontFamily="sans-serif"
        android:text="Medicamento"
        android:textColor="#000000"
        android:textSize="34sp"
        android:textStyle="bold|italic"
        app:layout_constraintBottom_toTopOf="@+id/vNombreMedicamento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:textSize="26sp" />

    <Button
        android:id="@+id/vVolverMedicamento"
        android:layout_width="370dp"
        android:layout_height="53dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="29dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#4E4E4E"
        android:paddingVertical="10dp"
        android:text="Volver"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>